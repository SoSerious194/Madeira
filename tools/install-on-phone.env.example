# Copy to tools/install-on-phone.env (git-ignored) and fill in.
# Your team ID: Xcode › Settings › Accounts, or the OU of your
# "Apple Development" certificate.
MADEIRA_TEAM=XXXXXXXXXX
# A bundle ID of your own; the JIT helper becomes <this>.JITHelper.
MADEIRA_BUNDLE_ID=dev.yourname.madeira
# Optional: which iPhone, when more than one is connected.
# MADEIRA_DEVICE=00008xxx-xxxxxxxxxxxxxxxx
